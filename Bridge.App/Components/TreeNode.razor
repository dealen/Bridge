@using Bridge.App.Models

@if (Node.IsVisible)
{
    <li @key="Node.Id" class="tree-node @(Node.IsLeaf ? "tree-node--leaf" : "tree-node--branch")">
        <div class="tree-node-row" @onclick="ToggleExpanded">
            @if (!Node.IsLeaf)
            {
                <button class="tree-toggle" aria-expanded="@Node.IsExpanded.ToString().ToLower()" tabindex="-1">
                    @(Node.IsExpanded ? "▼" : "▶")
                </button>
            }
            else
            {
                <span class="tree-toggle-placeholder"></span>
            }
            <span class="tree-label">@((MarkupString)GetColoredLabel(Node.Label, SearchQuery))</span>
        </div>

        @if (!Node.IsLeaf && Node.IsExpanded && Node.Children.Count > 0)
        {
            <ul class="tree-children">
                @foreach (BidNode childNode in Node.Children)
                {
                    <TreeNode @key="childNode.Id" Node="childNode" />
                }
            </ul>
        }
    </li>
}

@code {
    [Parameter, EditorRequired]
    public BidNode Node { get; set; } = default!;

    [CascadingParameter(Name = "SearchQuery")]
    public string SearchQuery { get; set; } = "";

    private void ToggleExpanded()
    {
        if (!Node.IsLeaf)
            Node.IsExpanded = !Node.IsExpanded;
    }

    private static string GetColoredLabel(string label, string searchQuery)
    {
        if (string.IsNullOrEmpty(label))
            return string.Empty;

        var htmlBuilder = new System.Text.StringBuilder();
        string? currentSpanClass = null;
        var currentRun = new System.Text.StringBuilder();

        void FlushRun()
        {
            if (currentRun.Length == 0) return;
            string runText = currentRun.ToString();
            string renderedText = string.IsNullOrWhiteSpace(searchQuery)
                ? System.Net.WebUtility.HtmlEncode(runText)
                : ApplyHighlight(runText, searchQuery);

            if (currentSpanClass is not null)
                htmlBuilder.Append($"<span class=\"{currentSpanClass}\">{renderedText}</span>");
            else
                htmlBuilder.Append(renderedText);

            currentRun.Clear();
        }

        foreach (char character in label)
        {
            string? requiredSpanClass = character switch
            {
                '♥' or '♦' => "suit-red",
                '♠' or '♣' => "suit-black",
                _ => null
            };

            if (requiredSpanClass != currentSpanClass)
            {
                FlushRun();
                currentSpanClass = requiredSpanClass;
            }

            currentRun.Append(character);
        }

        FlushRun();
        return htmlBuilder.ToString();
    }

    private static string ApplyHighlight(string text, string query)
    {
        var sb = new System.Text.StringBuilder();
        int position = 0;

        while (position < text.Length)
        {
            int matchIndex = text.IndexOf(query, position, StringComparison.OrdinalIgnoreCase);
            if (matchIndex < 0)
            {
                sb.Append(System.Net.WebUtility.HtmlEncode(text[position..]));
                break;
            }

            sb.Append(System.Net.WebUtility.HtmlEncode(text[position..matchIndex]));
            sb.Append("<mark class=\"search-highlight\">");
            sb.Append(System.Net.WebUtility.HtmlEncode(text.Substring(matchIndex, query.Length)));
            sb.Append("</mark>");
            position = matchIndex + query.Length;
        }

        return sb.ToString();
    }
}
