@using Bridge.App.Models
@inject Bridge.App.Services.TreeEditService EditService
@inject Microsoft.JSInterop.IJSRuntime JS

@if (Node.IsVisible)
{
    <li @key="Node.Id" class="tree-node @(Node.IsLeaf ? "tree-node--leaf" : "tree-node--branch")">
        <div class="tree-node-row @(IsEditMode && _isDragOver ? "drag-over" : "")"
             @onclick="HandleRowClick"
             draggable="@(IsEditMode ? "true" : "false")"
             @ondragstart="HandleDragStart"
             @ondragover:preventDefault
             @ondrop="HandleDrop"
             @ondragend="HandleDragEnd"
             @ondragenter="HandleDragEnter"
             @ondragleave="HandleDragLeave">
            @if (!Node.IsLeaf)
            {
                <button class="tree-toggle" aria-expanded="@Node.IsExpanded.ToString().ToLower()" tabindex="-1">
                    @(Node.IsExpanded ? "▼" : "▶")
                </button>
            }
            else
            {
                <span class="tree-toggle-placeholder"></span>
            }

            @if (IsEditMode && _isRenaming)
            {
                <input class="tree-rename-input"
                       type="text"
                       value="@_editBuffer"
                       @oninput="e => _editBuffer = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="HandleRenameKey"
                       @onblur="ConfirmRename"
                       @onclick:stopPropagation="true"
                       @ref="_renameInputRef" />
            }
            else if (IsEditMode)
            {
                <span class="tree-label" @onclick="HandleLabelClick" @onclick:stopPropagation="true">
                    @((MarkupString)GetColoredLabel(Node.Label, SearchQuery))
                </span>
                <div class="tree-edit-actions" @onclick:stopPropagation="true">
                    <button class="btn-node-action" title="Przesuń w górę" disabled="@IsFirstSibling" @onclick="HandleMoveUp">↑</button>
                    <button class="btn-node-action" title="Przesuń w dół" disabled="@IsLastSibling" @onclick="HandleMoveDown">↓</button>
                    <button class="btn-node-action" title="Dodaj węzeł podrzędny" @onclick="HandleAddChild">+</button>
                    <button class="btn-node-action btn-node-delete" title="Usuń węzeł" @onclick="HandleDelete">✕</button>
                </div>
            }
            else
            {
                <span class="tree-label">@((MarkupString)GetColoredLabel(Node.Label, SearchQuery))</span>
            }
        </div>

        @if (!Node.IsLeaf && Node.IsExpanded && Node.Children.Count > 0)
        {
            <ul class="tree-children">
                @foreach (BidNode childNode in Node.Children)
                {
                    <TreeNode @key="childNode.Id" Node="childNode" ParentChildren="Node.Children" />
                }
            </ul>
        }
    </li>
}

@code {
    [Parameter, EditorRequired]
    public BidNode Node { get; set; } = default!;

    /// <summary>
    /// The sibling list that contains this node. Null for top-level nodes rendered directly by TreeView
    /// (TreeView passes its root Nodes list instead). Used in edit mode for move-up/down.
    /// </summary>
    [Parameter]
    public List<BidNode>? ParentChildren { get; set; }

    [CascadingParameter(Name = "SearchQuery")]
    public string SearchQuery { get; set; } = "";

    [CascadingParameter(Name = "IsEditMode")]
    public bool IsEditMode { get; set; }

    // ── Rename state ──────────────────────────────────────────────────────────

    private bool _isRenaming;
    private string _editBuffer = string.Empty;
    private ElementReference _renameInputRef;
    private bool _shouldFocusRenameInput;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Auto-enter rename mode for a newly created child node.
        if (EditService.PendingRenameNodeId == Node.Id)
        {
            EditService.PendingRenameNodeId = null;
            EnterRenameMode();
            StateHasChanged();
            return;
        }

        if (_shouldFocusRenameInput)
        {
            _shouldFocusRenameInput = false;
            await _renameInputRef.FocusAsync();
        }
    }

    private void EnterRenameMode()
    {
        _editBuffer = Node.Label;
        _isRenaming = true;
        _shouldFocusRenameInput = true;
    }

    private void HandleLabelClick()
    {
        if (!IsEditMode) return;
        EnterRenameMode();
    }

    private void HandleRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            ConfirmRename();
        else if (e.Key == "Escape")
            CancelRename();
    }

    private void ConfirmRename()
    {
        if (!_isRenaming) return;
        _isRenaming = false;
        string trimmed = _editBuffer.Trim();
        if (!string.IsNullOrEmpty(trimmed) && trimmed != Node.Label)
            EditService.Rename(Node.Id, trimmed);
    }

    private void CancelRename()
    {
        _isRenaming = false;
        _editBuffer = Node.Label;
    }

    // ── Move up / Move down ────────────────────────────────────────────────────

    private bool IsFirstSibling => ParentChildren is null || ParentChildren.Count == 0 || ParentChildren[0].Id == Node.Id;
    private bool IsLastSibling  => ParentChildren is null || ParentChildren.Count == 0 || ParentChildren[^1].Id == Node.Id;

    private void HandleMoveUp()   => EditService.MoveUp(Node.Id, ParentChildren!);
    private void HandleMoveDown() => EditService.MoveDown(Node.Id, ParentChildren!);

    // ── Drag-to-reparent ──────────────────────────────────────────────────────

    private bool _isDragOver;

    private void HandleDragStart(DragEventArgs e)
    {
        EditService.DragSourceId = Node.Id;
    }

    private void HandleDragEnd(DragEventArgs e)
    {
        EditService.DragSourceId = null;
        _isDragOver = false;
    }

    private void HandleDragEnter(DragEventArgs e)
    {
        if (IsEditMode) _isDragOver = true;
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        _isDragOver = false;
    }

    private void HandleDrop(DragEventArgs e)
    {
        _isDragOver = false;
        if (!IsEditMode) return;
        string? sourceId = EditService.DragSourceId;
        EditService.DragSourceId = null;
        if (sourceId is null || sourceId == Node.Id) return;
        EditService.MoveToParent(sourceId, Node.Id);
    }

    // ── Add / Delete ──────────────────────────────────────────────────────────

    private void HandleAddChild()
    {
        EditService.AddChild(Node.Id);
    }

    private async Task HandleDelete()
    {
        if (Node.Children.Count > 0)
        {
            bool confirmed = await JS.InvokeAsync<bool>(
                "bridgeEdit.confirmDelete",
                $"Usunąć węzeł \"{Node.Label}\" i wszystkie jego węzły podrzędne ({Node.Children.Count})?");
            if (!confirmed) return;
        }
        EditService.Delete(Node.Id);
    }

    // ── Row click ─────────────────────────────────────────────────────────────

    private void HandleRowClick()
    {
        if (_isRenaming) return;  // blur will confirm the rename
        if (!Node.IsLeaf)
            Node.IsExpanded = !Node.IsExpanded;
    }

    private void ToggleExpanded()
    {
        if (!Node.IsLeaf)
            Node.IsExpanded = !Node.IsExpanded;
    }

    private static string GetColoredLabel(string label, string searchQuery)
    {
        if (string.IsNullOrEmpty(label))
            return string.Empty;

        var htmlBuilder = new System.Text.StringBuilder();
        string? currentSpanClass = null;
        var currentRun = new System.Text.StringBuilder();

        void FlushRun()
        {
            if (currentRun.Length == 0) return;
            string runText = currentRun.ToString();
            string renderedText = string.IsNullOrWhiteSpace(searchQuery)
                ? System.Net.WebUtility.HtmlEncode(runText)
                : ApplyHighlight(runText, searchQuery);

            if (currentSpanClass is not null)
                htmlBuilder.Append($"<span class=\"{currentSpanClass}\">{renderedText}</span>");
            else
                htmlBuilder.Append(renderedText);

            currentRun.Clear();
        }

        foreach (char character in label)
        {
            string? requiredSpanClass = character switch
            {
                '♥' or '♦' => "suit-red",
                '♠' or '♣' => "suit-black",
                _ => null
            };

            if (requiredSpanClass != currentSpanClass)
            {
                FlushRun();
                currentSpanClass = requiredSpanClass;
            }

            currentRun.Append(character);
        }

        FlushRun();
        return htmlBuilder.ToString();
    }

    private static string ApplyHighlight(string text, string query)
    {
        var sb = new System.Text.StringBuilder();
        int position = 0;

        while (position < text.Length)
        {
            int matchIndex = text.IndexOf(query, position, StringComparison.OrdinalIgnoreCase);
            if (matchIndex < 0)
            {
                sb.Append(System.Net.WebUtility.HtmlEncode(text[position..]));
                break;
            }

            sb.Append(System.Net.WebUtility.HtmlEncode(text[position..matchIndex]));
            sb.Append("<mark class=\"search-highlight\">");
            sb.Append(System.Net.WebUtility.HtmlEncode(text.Substring(matchIndex, query.Length)));
            sb.Append("</mark>");
            position = matchIndex + query.Length;
        }

        return sb.ToString();
    }
}
