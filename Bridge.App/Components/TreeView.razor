@using Bridge.App.Models
@using Bridge.App.Services

<CascadingValue Value="_searchQuery" Name="SearchQuery">
    <CascadingValue Value="_isEditMode" Name="IsEditMode">
        <ul class="tree-root">
            @foreach (BidNode topLevelNode in Nodes)
            {
                <TreeNode @key="topLevelNode.Id" Node="topLevelNode" ParentChildren="Nodes" />
            }
        </ul>
    </CascadingValue>
</CascadingValue>

@code {
    [Parameter, EditorRequired]
    public List<BidNode> Nodes { get; set; } = [];

    private string _searchQuery = "";
    private bool _isEditMode;

    public bool IsEditMode => _isEditMode;

    public void ToggleEditMode()
    {
        if (!_isEditMode)
        {
            // Reset search state before entering edit mode
            ApplyFilter("");
        }
        _isEditMode = !_isEditMode;
        StateHasChanged();
    }

    public void ExpandAll()
    {
        SetExpandedRecursive(Nodes, expanded: true);
        StateHasChanged();
    }

    public void CollapseAll()
    {
        SetExpandedRecursive(Nodes, expanded: false);
        StateHasChanged();
    }

    /// <summary>Applies a case-insensitive filter to the tree and returns the match count.</summary>
    public int ApplyFilter(string query)
    {
        _searchQuery = query;
        int matchCount = TreeFilterHelper.ApplyFilter(Nodes, query);
        StateHasChanged();
        return matchCount;
    }

    private static void SetExpandedRecursive(List<BidNode> nodes, bool expanded)
    {
        foreach (BidNode node in nodes)
        {
            node.IsExpanded = expanded;
            if (node.Children.Count > 0)
                SetExpandedRecursive(node.Children, expanded);
        }
    }
}
