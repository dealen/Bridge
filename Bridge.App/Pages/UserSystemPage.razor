@page "/moje-systemy/{Id}"
@implements IDisposable
@inject TreeEditService EditService
@inject NavigationManager Nav

<PageTitle>@(_document?.SourceFile ?? "Mój system")</PageTitle>

<h2 class="page-heading">@(_document?.SourceFile ?? "Mój system")</h2>

@if (_document is null && _errorMessage is null)
{
    <p class="loading-text">Ładowanie danych...</p>
}
else if (_errorMessage is not null)
{
    <p class="error-text">Błąd ładowania: @_errorMessage</p>
}
else
{
    <p class="doc-meta">Sekcji najwyższego poziomu: @_document!.TopLevelCount</p>

    <div class="page-toolbar">
        <SearchBar OnSearch="HandleSearch" MatchCount="_matchCount" Disabled="_isEditMode" />
        <div class="toolbar-buttons">
            <button class="btn-tree-action @(_isEditMode ? "btn-tree-action--active" : "")"
                    @onclick="ToggleEditMode">Tryb edycji</button>
            @if (_isEditMode)
            {
                <button class="btn-tree-action" @onclick="() => EditService.AddRootNode(DocKey)">Dodaj sekcję</button>
                <button class="btn-tree-action" @onclick="() => _treeView?.ExpandAll()">Rozwiń wszystko</button>
                <button class="btn-tree-action" @onclick="() => _treeView?.CollapseAll()">Zwiń wszystko</button>
                <button class="btn-tree-action" @onclick="ExportAsync">Eksportuj JSON</button>
                <label class="btn-tree-action btn-tree-action--import">
                    Importuj JSON
                    <InputFile OnChange="HandleImportAsync" accept=".json" style="display:none" />
                </label>
            }
            else
            {
                <button class="btn-tree-action" @onclick="() => _treeView?.ExpandAll()">Rozwiń wszystko</button>
                <button class="btn-tree-action" @onclick="() => _treeView?.CollapseAll()">Zwiń wszystko</button>
            }
        </div>
        @if (_isEditMode && EditService.IsDirtyFor(DocKey))
        {
            <span class="dirty-indicator">&#9679; Niezapisane zmiany</span>
        }
    </div>

    @if (_importError is not null)
    {
        <p class="error-text">Błąd importu: @_importError</p>
    }

    <TreeView Nodes="_document!.Nodes" @ref="_treeView" />
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private string DocKey => TreeEditService.UserDocKey(Id);

    private BridgeDocument? _document;
    private string? _errorMessage;
    private string? _importError;
    private TreeView? _treeView;
    private int _matchCount;
    private bool _isEditMode;

    protected override async Task OnInitializedAsync()
    {
        EditService.OnChange += HandleChange;
        try
        {
            _document = await EditService.GetUserDocumentAsync(Id);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    public void Dispose()
    {
        EditService.OnChange -= HandleChange;
        _ = EditService.FlushPendingSaveAsync(DocKey);
    }

    private void HandleChange()
    {
        // Mutations modify _document.Nodes in place; imports update _document directly in HandleImportAsync.
        // Calling StateHasChanged() synchronously avoids an async re-render race with TreeNode lifecycle.
        StateHasChanged();
    }

    private void ToggleEditMode()
    {
        _isEditMode = !_isEditMode;
        _treeView?.ToggleEditMode();
    }

    private void HandleSearch(string searchQuery)
    {
        if (_treeView is not null)
            _matchCount = _treeView.ApplyFilter(searchQuery);
        StateHasChanged();
    }

    private async Task ExportAsync()
    {
        if (_document is null) return;
        string safeName = string.Concat((_document.SourceFile ?? "system").Where(c => !Path.GetInvalidFileNameChars().Contains(c)));
        await EditService.ExportAsync(_document, $"{safeName}-{Id}.json");
    }

    private async Task HandleImportAsync(InputFileChangeEventArgs e)
    {
        _importError = null;
        try
        {
            await using Stream stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            await EditService.ImportAsync(stream, DocKey);
            _document = await EditService.GetUserDocumentAsync(Id);
        }
        catch (Exception ex)
        {
            _importError = ex.Message;
            StateHasChanged();
        }
    }
}
